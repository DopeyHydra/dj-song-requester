<?xml version="1.0" encoding="utf-8"?>
<!-- HTTP erlauben, damit auch Server im Heimnetz ohne HTTPS (z. B. http://192.168.1.10:3000) funktionieren -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
