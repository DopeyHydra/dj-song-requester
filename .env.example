# ============ DJ Song Requester – Konfiguration ============
# Kopieren nach .env und Werte anpassen:  cp .env.example .env

# --- Admin-Zugang (wird beim ERSTEN Start als scrypt-Hash in der Datenbank gespeichert) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Nach dem ersten Start kann ADMIN_PASSWORD aus dieser Datei entfernt werden.
# Spätere Änderungen: im Admin-Panel unter "Einstellungen" oder per CLI (siehe README).

# --- Optional: Anmeldung per OIDC / Keycloak (Anleitung in der README) ---
# Issuer = Realm-URL, z. B. https://auth.example.com/realms/meinrealm
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Wer ins Admin-Panel darf (mindestens eins davon setzen, mehrere Werte mit Komma trennen):
OIDC_ALLOWED_ROLES=dj-admin
OIDC_ALLOWED_USERS=
# Wo die Rollen im Token stehen. Keycloak-Realm-Rollen: realm_access.roles
# Keycloak-Client-Rollen: resource_access.<client-id>.roles
OIDC_ROLES_CLAIM=realm_access.roles
OIDC_BUTTON_LABEL=Mit Keycloak anmelden
# Nur nötig, wenn die automatisch ermittelte Callback-URL nicht passt:
OIDC_REDIRECT_URI=
# false = nur noch OIDC-Login, kein Benutzername/Passwort mehr
PASSWORD_LOGIN=true

# --- Spotify (https://developer.spotify.com/dashboard → App anlegen) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=DE

# Ohne Spotify-Zugangsdaten ausprobieren (Suche liefert Beispielsongs)
DEMO_MODE=false

# --- Allgemein ---
EVENT_NAME=DJ Song Requester
# Port auf dem Host
HOST_PORT=3000
# Öffentliche Adresse für den QR-Code (kann auch im Admin-Panel gesetzt werden).
# Leer = wird automatisch aus der Browser-Adresse des Admins ermittelt.
PUBLIC_URL=

# --- Gäste-Limits ---
REQUEST_LIMIT_PER_GUEST=5
REQUEST_LIMIT_WINDOW_MINUTES=15

# --- Reverse Proxy / Cookies ---
# auto = Secure-Cookie, wenn die Anfrage per HTTPS kam (über X-Forwarded-Proto vom Proxy)
COOKIE_SECURE=auto
# Welche Proxies X-Forwarded-* setzen dürfen (Express "trust proxy")
TRUST_PROXY=loopback, linklocal, uniquelocal
